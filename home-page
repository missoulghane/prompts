<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Espace Syndic</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f6f7f5;
      color: #202522;
    }

    .container {
      max-width: 1180px;
      margin: 0 auto;
      padding: 40px 24px 60px;
    }

    /* HEADER */

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 36px;
    }

    .greeting h1 {
      margin: 0 0 6px;
      font-size: 28px;
      font-weight: 600;
      letter-spacing: -0.5px;
    }

    .greeting p {
      margin: 0;
      color: #737a75;
      font-size: 15px;
    }

    .profile {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: #dfe6df;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 600;
      color: #4e5b51;
    }

    /* ACTIONS */

    .actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      margin-bottom: 28px;
    }

    .action {
      background: white;
      border: 1px solid #e4e7e3;
      border-radius: 14px;
      padding: 22px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      transition: .2s ease;
    }

    .action:hover {
      border-color: #c9d0ca;
      transform: translateY(-1px);
    }

    .action-content {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .action-icon {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: #f0f3ef;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
    }

    .action strong {
      display: block;
      font-size: 16px;
      margin-bottom: 4px;
    }

    .action span {
      font-size: 13px;
      color: #7a817c;
    }

    .arrow {
      font-size: 20px;
      color: #9aa19c;
    }

    /* ATTENTION */

    .section-title {
      font-size: 14px;
      font-weight: 600;
      color: #686f6a;
      margin: 0 0 12px;
    }

    .attention {
      background: #fff;
      border: 1px solid #e4e7e3;
      border-radius: 14px;
      margin-bottom: 28px;
      overflow: hidden;
    }

    .attention-item {
      padding: 18px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #eef0ed;
    }

    .attention-item:last-child {
      border-bottom: none;
    }

    .attention-left {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .status {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: #d6a94c;
    }

    .attention-item strong {
      display: block;
      font-size: 14px;
      margin-bottom: 3px;
    }

    .attention-item small {
      color: #818882;
      font-size: 12px;
    }

    .amount {
      font-size: 14px;
      font-weight: 600;
    }

    /* GRID */

    .dashboard-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }

    .card {
      background: white;
      border: 1px solid #e4e7e3;
      border-radius: 14px;
      padding: 22px;
    }

    /* COPRO */

    .copro-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 24px;
    }

    .copro-name {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 5px;
    }

    .copro-address {
      color: #818882;
      font-size: 13px;
    }

    .badge {
      font-size: 11px;
      padding: 5px 9px;
      border-radius: 20px;
      background: #f0f3ef;
      color: #68736b;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    .stat {
      padding: 14px;
      background: #f7f8f6;
      border-radius: 10px;
    }

    .stat-label {
      font-size: 11px;
      color: #858b86;
      margin-bottom: 8px;
    }

    .stat-value {
      font-size: 17px;
      font-weight: 600;
    }

    /* COMPTES */

    .accounts {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .account {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px;
      background: #f7f8f6;
      border-radius: 10px;
    }

    .account-info {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .account-icon {
      width: 34px;
      height: 34px;
      border-radius: 8px;
      background: white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
    }

    .account-name {
      font-size: 14px;
      font-weight: 600;
    }

    .account-detail {
      font-size: 11px;
      color: #858b86;
      margin-top: 3px;
    }

    .account-balance {
      font-size: 15px;
      font-weight: 600;
    }

    /* OPERATIONS */

    .operations {
      background: white;
      border: 1px solid #e4e7e3;
      border-radius: 14px;
      overflow: hidden;
    }

    .operations-header {
      padding: 20px 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .operations-header h2 {
      margin: 0;
      font-size: 15px;
      font-weight: 600;
    }

    .operations-header a {
      color: #657168;
      font-size: 12px;
      text-decoration: none;
    }

    .operation {
      display: grid;
      grid-template-columns: 70px 1fr auto;
      gap: 15px;
      align-items: center;
      padding: 15px 22px;
      border-top: 1px solid #eef0ed;
    }

    .date {
      font-size: 12px;
      color: #858b86;
    }

    .operation-name {
      font-size: 13px;
      font-weight: 500;
    }

    .operation-account {
      font-size: 11px;
      color: #858b86;
      margin-top: 3px;
    }

    .positive {
      color: #4d7359;
      font-weight: 600;
      font-size: 13px;
    }

    .negative {
      color: #555b57;
      font-weight: 600;
      font-size: 13px;
    }

    /* RESPONSIVE */

    @media (max-width: 760px) {
      .container {
        padding: 28px 16px 40px;
      }

      header {
        margin-bottom: 28px;
      }

      .greeting h1 {
        font-size: 23px;
      }

      .actions,
      .dashboard-grid {
        grid-template-columns: 1fr;
      }

      .stats {
        grid-template-columns: 1fr 1fr;
      }

      .operation {
        grid-template-columns: 55px 1fr auto;
      }
    }
  </style>
</head>

<body>

  <main class="container">

    <!-- HEADER -->
    <header>
      <div class="greeting">
        <h1>Bonjour Jean</h1>
        <p>Bienvenue dans votre espace syndic</p>
      </div>

      <div class="profile">JD</div>
    </header>


    <!-- ACTIONS PRINCIPALES -->
    <section class="actions">

      <div class="action">
        <div class="action-content">
          <div class="action-icon">＋</div>
          <div>
            <strong>Saisir une dépense</strong>
            <span>Facture, fournisseur, paiement...</span>
          </div>
        </div>
        <div class="arrow">→</div>
      </div>

      <div class="action">
        <div class="action-content">
          <div class="action-icon">↓</div>
          <div>
            <strong>Saisir une recette</strong>
            <span>Appel de fonds, règlement...</span>
          </div>
        </div>
        <div class="arrow">→</div>
      </div>

    </section>


    <!-- A SURVEILLER -->
    <h2 class="section-title">À surveiller</h2>

    <section class="attention">

      <div class="attention-item">
        <div class="attention-left">
          <div class="status"></div>
          <div>
            <strong>Échéances à collecter</strong>
            <small>3 échéances en attente</small>
          </div>
        </div>
        <div class="amount">1 250 €</div>
      </div>

      <div class="attention-item">
        <div class="attention-left">
          <div class="status"></div>
          <div>
            <strong>Factures à payer</strong>
            <small>2 factures en attente</small>
          </div>
        </div>
        <div class="amount">480 €</div>
      </div>

    </section>


    <!-- COPRO + COMPTES -->
    <section class="dashboard-grid">

      <!-- COPROPRIETE -->
      <div class="card">

        <div class="copro-header">
          <div>
            <div class="copro-name">Résidence Les Tilleuls</div>
            <div class="copro-address">
              12 rue des Lilas · 75000 Paris
            </div>
          </div>

          <div class="badge">12 lots</div>
        </div>

        <div class="stats">

          <div class="stat">
            <div class="stat-label">Lots</div>
            <div class="stat-value">12</div>
          </div>

          <div class="stat">
            <div class="stat-label">Copropriétaires</div>
            <div class="stat-value">8</div>
          </div>

          <div class="stat">
            <div class="stat-label">Exercice</div>
            <div class="stat-value">2026</div>
          </div>

        </div>

      </div>


      <!-- COMPTES -->
      <div class="card">

        <h2 class="section-title">Vos comptes</h2>

        <div class="accounts">

          <div class="account">
            <div class="account-info">
              <div class="account-icon">▣</div>
              <div>
                <div class="account-name">Banque</div>
                <div class="account-detail">
                  Dernière opération : 18 août
                </div>
              </div>
            </div>

            <div class="account-balance">3 850 €</div>
          </div>


          <div class="account">
            <div class="account-info">
              <div class="account-icon">€</div>
              <div>
                <div class="account-name">Caisse</div>
                <div class="account-detail">
                  Dernière opération : 15 août
                </div>
              </div>
            </div>

            <div class="account-balance">430 €</div>
          </div>

        </div>

      </div>

    </section>


    <!-- DERNIERES OPERATIONS -->
    <h2 class="section-title">Dernières opérations</h2>

    <section class="operations">

      <div class="operations-header">
        <h2>Activité récente</h2>
        <a href="#">Voir toutes les opérations →</a>
      </div>


      <div class="operation">
        <div class="date">18 août</div>

        <div>
          <div class="operation-name">Règlement copropriétaire</div>
          <div class="operation-account">Banque · Recette</div>
        </div>

        <div class="positive">+250 €</div>
      </div>


      <div class="operation">
        <div class="date">17 août</div>

        <div>
          <div class="operation-name">Achat fournitures</div>
          <div class="operation-account">Caisse · Dépense</div>
        </div>

        <div class="negative">−120 €</div>
      </div>


      <div class="operation">
        <div class="date">15 août</div>

        <div>
          <div class="operation-name">Facture entretien</div>
          <div class="operation-account">Banque · Dépense</div>
        </div>

        <div class="negative">−320 €</div>
      </div>


      <div class="operation">
        <div class="date">12 août</div>

        <div>
          <div class="operation-name">Règlement copropriétaire</div>
          <div class="operation-account">Banque · Recette</div>
        </div>

        <div class="positive">+80 €</div>
      </div>

    </section>

  </main>

</body>
</html>
